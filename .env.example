# Copy to .env if you need overrides. No secrets are required.
BISTRO_HOST=127.0.0.1
BISTRO_PORT=8000
BISTRO_OLLAMA_URL=http://127.0.0.1:11434
# Legacy default only; a saved runtime/ai.json selection takes precedence.
# Double-click configure_ai.bat to select/change a tested installed model.
BISTRO_MODEL=qwen2.5:7b
BISTRO_CURRENCY=PHP
# Demonstration values, not official professor rates.
BISTRO_TAX_RATE=0
BISTRO_SERVICE_RATE=0
# Allow extra time for cold model loading; max 600 seconds.
BISTRO_OLLAMA_TIMEOUT=120
